rules_version = '2';

// BrickLess Firestore rules. Deploy with: firebase deploy --only firestore:rules
// (Firebase console: Firestore Database must exist first, and
// Email/Password must be enabled in Authentication > Sign-in method.)
//
// Collections:
//   users/{uid}       - public profiles, one per Auth user
//   usernames/{lower} - username reservations { uid, email }
//   friendships/{id}  - friend requests / friendships (see FriendsStore)
//   courts/{id}       - community-added courts/fields (see CourtStore)
//   bookings/{id}     - court bookings / game slots
//   events/{id}       - pickup games posted at a court (see EventStore)
//   events/{id}/messages/{msgId} - group chat for one game
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profiles: anyone signed in can read; only the owner can write.
    // Delete must be allowed for the owner: in-app Delete Account
    // (App Store Guideline 5.1.1(v)) removes the profile doc and the
    // username reservation, so the name can be used again. With delete
    // forbidden the Auth user was gone but the username stayed reserved.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // Username reservations: anyone signed in can read (for login-by-username
    // and availability checks). A user can only claim a name for themself,
    // and only when that name is not already taken.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(name));
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friendships: readable by the two people involved; a request can only
    // be created by the requester, accepted/declined by the other side.
    match /friendships/{id} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.status in ["accepted", "declined"];
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    // Blocks (Guideline 1.2): only the blocker can read, create or
    // remove their own blocks. Stored server-side so they survive reinstalls.
    match /blocks/{uid}/blocked/{otherUid} {
      allow read, create, delete: if isOwner(uid);
    }

    // Reports (Guideline 1.2): anyone signed in can file one about someone
    // else. Nobody but the reporter can read them from the app; they are
    // reviewed in the Firebase console, where reports must be acted on
    // within 24 hours. The reporter can read and delete their own
    // reports, so Delete Account can clean them up (LoginSession.deleteAccount).
    match /reports/{id} {
      allow read: if signedIn()
        && resource.data.reporterUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.reporterUid == request.auth.uid;
    }

    // Courts/fields: anyone signed in can read; any signed-in user can add
    // one; only the creator can edit it.
    match /courts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    // Bookings: any signed-in user can read them. The overlap check in
    // BookingStore has to read other players' confirmed bookings for the
    // same court, or it silently sees nothing and double-books. Booking
    // docs hold only user IDs, court IDs and times (no names or emails),
    // and pickup games are public by nature, so this is the honest
    // trade-off. Only the booker can create or cancel a booking.
    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.bookedBy == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.bookedBy == request.auth.uid
          || request.auth.uid in resource.data.playerUids);
      allow delete: if signedIn() && resource.data.bookedBy == request.auth.uid;
    }

    // Events: pickup games posted at a court. Listings are public to any
    // signed-in user so anyone can discover and join a game. Joining and
    // leaving change only playerUids, by exactly the caller, and the cap
    // is enforced in the rules (maxPlayers 2-30, and the player list
    // itself capped at 30). The creator can edit metadata but not
    // membership, the cap, or the creator. Overlapping events at the
    // same court are allowed: these are pickup games, not facility
    // reservations.
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.playerUids == [request.auth.uid]
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.maxPlayers <= 30
        && request.resource.data.endTime > request.resource.data.startTime;
      allow update: if signedIn()
        && (
          // (1) Membership-only change, by anyone including the creator:
          // exactly the caller added OR exactly the caller removed,
          // nothing else added or removed, no duplicates, cap holds.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerUids'])
            && request.resource.data.playerUids.size() <= resource.data.maxPlayers
            && request.resource.data.playerUids.size() <= 30
            && request.resource.data.playerUids.toSet().size() == request.resource.data.playerUids.size()
            && (
              // join: new = old + caller
              (request.resource.data.playerUids.size() == resource.data.playerUids.size() + 1
                && request.auth.uid in request.resource.data.playerUids
                && !(request.auth.uid in resource.data.playerUids)
                && resource.data.playerUids.toSet().difference(request.resource.data.playerUids.toSet()).size() == 0
                && request.resource.data.playerUids.toSet().difference(resource.data.playerUids.toSet()).size() == 1)
              // leave: new = old - caller
              || (request.resource.data.playerUids.size() == resource.data.playerUids.size() - 1
                && request.auth.uid in resource.data.playerUids
                && !(request.auth.uid in request.resource.data.playerUids)
                && request.resource.data.playerUids.toSet().difference(resource.data.playerUids.toSet()).size() == 0
                && resource.data.playerUids.toSet().difference(request.resource.data.playerUids.toSet()).size() == 1)
            ))
          // (2) Creator metadata edit only: must not touch playerUids,
          // maxPlayers, or creatorUid.
          || (resource.data.creatorUid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['playerUids', 'maxPlayers', 'creatorUid']))
        );
      allow delete: if signedIn()
        && resource.data.creatorUid == request.auth.uid;
    }

    // Group chat: only players who joined the event can read or post.
    // The get() reads the parent event doc to check playerUids.
    // The event creator can delete messages, so deleting a game can
    // delete its chat too (EventStore.deleteEvent deletes the messages
    // first, then the event doc). Nobody else can delete a message.
    match /events/{eventId}/messages/{msgId} {
      allow read: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.playerUids;
      allow create: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.playerUids
        && request.resource.data.senderUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.creatorUid;
    }
  }
}
